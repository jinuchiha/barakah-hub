# ═══════════════════════════════════════════════════════════════════
# Barakah Hub — environment template (Neon + Better-Auth)
# Copy to `.env.local` and fill in real values.
# Never commit the populated file (it is gitignored via `.env.*`).
# ═══════════════════════════════════════════════════════════════════

# ── Neon Postgres ──────────────────────────────────────────────────
# Pooled connection (PgBouncer-fronted) — used by app runtime.
# Get via: `neonctl connection-string production --pooled`
DATABASE_URL=postgresql://<user>:<pw>@<host>-pooler.<region>.aws.neon.tech/<db>?sslmode=require

# Direct connection (no pooler) — required by drizzle-kit / our migrate
# script because PgBouncer transaction mode rejects DDL prepared statements.
# Get via: `neonctl connection-string production`
DATABASE_URL_DIRECT=postgresql://<user>:<pw>@<host>.<region>.aws.neon.tech/<db>?sslmode=require

# ── Better-Auth ────────────────────────────────────────────────────
# Generate with: openssl rand -base64 32
# Must be ≥32 chars. App will throw at boot if unset, default, or shorter.
BETTER_AUTH_SECRET=

# Origin used for CSRF / cookie domain. Set to the deployed URL in prod.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Email transport (Resend) — for password-reset delivery (optional) ─
# RESEND_API_KEY=re_...
# RESEND_FROM=Barakah Hub <noreply@yourdomain.com>

# ── Object storage (Vercel Blob) — avatar + receipt uploads ────────
# In the Vercel dashboard: Storage → Create → Blob, then link it to this
# project. Vercel injects BLOB_READ_WRITE_TOKEN automatically on deploy;
# set it here only for local uploads. When unset, dev falls back to
# public/uploads and production returns 501.
BLOB_READ_WRITE_TOKEN=

# ── Cron protection ────────────────────────────────────────────────
# Required: the cron endpoints (/api/cron/*) reject all requests unless
# the Authorization header matches `Bearer $CRON_SECRET`. Vercel Cron is
# configured to send this. Generate with: openssl rand -base64 32
CRON_SECRET=

# ── Error tracking (Sentry) ────────────────────────────────────────
# SENTRY_DSN covers the SERVER: server actions, API routes and cron jobs.
# NEXT_PUBLIC_SENTRY_DSN covers the BROWSER. Setting only the public one
# leaves every server-side failure unreported — set both (same value is
# fine) or the server falls back to the public var.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
# Optional: enables source-map upload at build time.
SENTRY_AUTH_TOKEN=

# WhatsApp Cloud API — automated reminders (optional; deep links work without)
# Business-initiated messages need an approved template; set its name below.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Approved template names. Meta REJECTS business-initiated free text outside
# a 24-hour customer-service window, so without these the app can only reach
# members who happen to have messaged the business number recently — receipts
# and alerts to everyone else are refused (logged as "outside-session-window").
WHATSAPP_TEMPLATE_REMINDER=
WHATSAPP_TEMPLATE_RECEIPT=
WHATSAPP_TEMPLATE_EMERGENCY=
