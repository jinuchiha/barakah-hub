{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "crons": [
    {
      "path": "/api/cron/reminders",
      "schedule": "0 9 25 * *"
    },
    {
      "path": "/api/cron/monthly-statements",
      "schedule": "0 9 1 * *"
    }
  ],
  "buildCommand": "cd next-app && pnpm build",
  "installCommand": "cd next-app && pnpm install --frozen-lockfile"
}
